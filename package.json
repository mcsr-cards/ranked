{
  "name": "@mcsr-cards/ranked",
  "version": "0.2.2",
  "description": "Typed client for the MCSR Ranked API, with caching and rate limiting",
  "keywords": [
    "mcsr",
    "mcsrranked",
    "minecraft",
    "speedrun",
    "api",
    "client",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcsr-cards/ranked.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "update-spec": "node scripts/update-spec.mjs",
    "generate": "openapi-typescript openapi.yaml -o src/schema.d.ts && node scripts/generate-schemas.mjs",
    "build": "tsup",
    "prepare": "tsup"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "^22",
    "js-yaml": "^4.3.2",
    "openapi-typescript": "^7.9.1",
    "tsup": "^8.5.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
